#version 430

layout( local_size_x = 256, local_size_y = 1, local_size_z = 1 ) in;

struct Particle {
	vec4 position;
	vec4 velocity;
	vec4 color;
};

layout( std430, binding = 0 ) buffer ParticleBuffer {
	Particle particles[];
};

uniform float uTimeStep;
uniform float uGravityStrength;
uniform vec3 uAttractorPosition;

void main()
{
	uint id = gl_GlobalInvocationID.x;

	Particle p = particles[id];

	// Calculate force towards attractor
	vec3 toAttractor = uAttractorPosition - p.position.xyz;
	float dist = length( toAttractor );

	// Avoid singularity at center
	dist = max( dist, 1.0 );

	// Gravity force: F = G * m1 * m2 / r^2
	// (assuming all particles have mass = 1)
	vec3 force = normalize( toAttractor ) * uGravityStrength / ( dist * dist );

	// Update velocity: v = v + a * dt (where a = F/m, and m = 1)
	p.velocity.xyz += force * uTimeStep;

	// Apply damping to prevent infinite acceleration
	p.velocity.xyz *= 0.999;

	// Update position: p = p + v * dt
	p.position.xyz += p.velocity.xyz * uTimeStep;

	// Write back
	particles[id] = p;
}
